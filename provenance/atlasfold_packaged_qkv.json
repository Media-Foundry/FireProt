    "fireprot_atlas_qkv_packaged_tests.py": {
      "source": "import torch,os,json,pathlib,sys,importlib.machinery\nclass TestDependencies:\n def find_spec(self,fullname,path=None,target=None):\n  if path is None and fullname in {'pytest','_pytest','pluggy','iniconfig','packaging','pygments','py'}:\n   return importlib.machinery.PathFinder.find_spec(fullname,['/home/pc/anaconda3/envs/fold/lib/python3.12/site-packages'])\nsys.meta_path.insert(0,TestDependencies())\nimport pytest\nfrom benchmarks.atlasfold.profile_inference import resolve_physical_device,_GpuProcessMonitor\ntorch.cuda.init();device=resolve_physical_device();monitor=_GpuProcessMonitor(device['gpu'],os.getpid(),1);monitor.start();code=1\ntry:code=pytest.main(['-q','tests/operators/test_atlasfold_runtime.py','tests/operators/test_atlasfold_pair_fusions.py'])\nfinally:\n report={'device':device,'isolation':monitor.stop(),'exit_code':int(code),'pytest_source':pytest.__file__,'torch_source':torch.__file__}\n pathlib.Path('outputs/atlasfold/packaged-qkv-tests.json').write_text(json.dumps(report,indent=2));print(json.dumps(report))\nraise SystemExit(code)\n",
      "sha256": "c8e2237f8449c7b7159a19c9f370a4dfbe88602b969502b32b526a60ed1a162a"
    },
    "fireprot_atlas_qkv_packaged_model.py": {
      "source": "\"\"\"Validate packaged QKV kernels against saved native outputs with source hashes.\"\"\"\nimport hashlib,json,os,pathlib,subprocess,sys\nimport numpy as np\nroot=pathlib.Path('/media/IntelSSD/fireprot')\nn=int(sys.argv[1]);assert n in (1000,1536)\nout=root/f'outputs/atlasfold/packaged-qkv-n{n}-seed102-r1';assert not out.exists()\nfiles=['fireprot/adapters/atlasfold/runtime.py','fireprot/backends/amd/pair_fusions.py','fireprot/backends/amd/csrc/fireprot_pair_fusions.cpp','fireprot/backends/amd/csrc/fireprot_pair_softmax.cu','fireprot/backends/amd/csrc/fireprot_pair_transpose.cu','fireprot/backends/amd/csrc/fireprot_pair_qkv.cu']\nhashes={p:hashlib.sha256((root/p).read_bytes()).hexdigest() for p in files}\npython='/media/PM982/engramfold/folding_e2e_20260921/venvs/atlasfold-rocm/bin/python'\nsubprocess.run([python,'-c','from fireprot.backends.amd.pair_fusions import load,manifest; assert load() is not None,manifest(); print(manifest())'],cwd=root,check=True)\nsource='umem_L01000_462bb697ecdcce2f.json' if n==1000 else 'umem_L01536_6b140cc19f02d9b9.json'\ncmd=[python,'-m','benchmarks.atlasfold.profile_inference','--input',str(root/'benchmarks/protenix/inputs'/source),'--out',str(out),'--backend','hip-fused','--seed','102','--repeats','1','--stage-events','off']\nif n==1536:cmd+=['--allow-long1536']\nwith out.with_suffix('.log').open('w') as log:subprocess.run(cmd,cwd=root,stdout=log,stderr=subprocess.STDOUT,check=True)\nm=json.loads((out/'manifest.json').read_text());assert m['status']=='complete' and m['isolation']['passed']\nassert m['fireprot']['counts']['fused_attention']==528 and m['fireprot']['counts']['hip_multiplication']==528\nassert m['fireprot']['counts']['native_fallback']==0\nfor p,h in hashes.items():\n assert hashlib.sha256((root/p).read_bytes()).hexdigest()==h,p\n assert m['fireprot']['implementation_sha256'][pathlib.Path(p).name]==h,p\nref=root/'outputs/atlasfold'/('native-n1000-seed102-noevents' if n==1000 else 'chunked-native-n1536-seed102-noevents')\na=np.load(ref/'repeat0-seed102-sample0.npz');b=np.load(out/'repeat0-seed102-sample0.npz')\nchecks={k:a[k].shape==b[k].shape and a[k].dtype==b[k].dtype and a[k].tobytes()==b[k].tobytes() for k in a.files}\nassert set(a.files)==set(b.files) and all(checks.values())\nr={'status':'complete','source_sha256':hashes,'reference':str(ref),'raw_bytes_equal':checks,'manifest':m,'scope':'Packaged correctness validation; saved native reference was measured separately. No new paired native speedup claim.'}\n(out/'validation.json').write_text(json.dumps(r,indent=2)+'\\n')\nprint(json.dumps({'length':n,'request_seconds':m['first_request_seconds'],'raw_bytes_equal':checks,'device':m['device']}),flush=True)\n",
      "sha256": "4c3dc4bb0666ebc9b839a493919cef4f868c5d84e749c5213eab158339470f1d"
    }
