  "artifact_note": "The norm-layout probe initially reused the compact probe output filename. Its kernel hash was verified, its report copied to norm-layout-probe.json, and the original compact report restored from committed evidence. The archived script below records the actual executed source.",
  "norm_layout_probe": {
    "fireprot_atlas_norm_layout_probe.py": {
      "source": "\"\"\"Reject compact reuse unless all operator outputs remain exactly equal.\"\"\"\nimport os,json,pathlib,statistics,hashlib\nimport torch\nfrom torch.utils.cpp_extension import load\nfrom fireprot.adapters.atlasfold.runtime import triangle_attention\nfrom fireprot.backends.amd.pair_fusions import load as load_reference\nfrom benchmarks.atlasfold.profile_inference import resolve_physical_device,_GpuProcessMonitor\nfrom atlasfold.model.network.primitives.triangle_update import TriangleAttentionStartingNode,TriangleAttentionEndingNode\n\ntorch.set_num_threads(8);torch.manual_seed(1123);torch.cuda.init()\ndevice=resolve_physical_device();monitor=_GpuProcessMonitor(device['gpu'],os.getpid(),1);monitor.start()\nsource=pathlib.Path('/tmp/fireprot_atlas_norm_layout_probe.cu')\nbuild=pathlib.Path('/media/IntelSSD/fireprot/runtime/atlas_norm_layout_probe');build.mkdir(parents=True,exist_ok=True)\nreport={'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),'device':device,'edges':[],'operators':[]}\ntry:\n ext=load(name='atlas_norm_layout_probe',sources=[str(source)],build_directory=str(build),extra_cuda_cflags=['-O3'],verbose=False)\n reference_ext=load_reference();assert reference_ext is not None\n def bench(fn):\n  samples=[]\n  for i in range(4):\n   a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();y=fn();b.record();b.synchronize()\n   if i:samples.append(a.elapsed_time(b))\n  return y,statistics.median(samples)\n with torch.inference_mode(),torch.autocast('cuda',dtype=torch.bfloat16):\n  state=torch.load('/media/PM982/engramfold/folding_e2e_20260921/weights/atlasfold/snapshot/weights/atlasfold-260703.pth',map_location='cpu',weights_only=True,mmap=True)\n  for n,validn in ((1024,1000),(1536,1536)):\n   for ending in (True,):\n    cls=TriangleAttentionEndingNode if ending else TriangleAttentionStartingNode\n    m=cls(128,4).eval().cuda().bfloat16();prefix='main_stack.blocks.0.'+('tri_attn_end.' if ending else 'tri_attn_start.')\n    m.load_state_dict({k[len(prefix):]:v for k,v in state.items() if k.startswith(prefix)},strict=True)\n    x=torch.randn(1,n,n,128,device='cuda',dtype=torch.bfloat16)\n    valid=torch.arange(n,device='cuda')<validn;mask=valid[None,:,None]&valid[None,None,:]\n    ref,t0=bench(lambda:triangle_attention(m,x,mask,ending=ending,extension=reference_ext,valid_length=validn,fuse_softmax=True))\n    original_norm=m.layernorm.forward\n    def norm(value):\n     packed=ext.transpose_cast(value)\n     return original_norm(packed).to(value.dtype)\n    m.layernorm.forward=norm\n    y,t1=bench(lambda:triangle_attention(m,x,mask,ending=ending,extension=reference_ext,valid_length=validn,fuse_softmax=True))\n    row={'length':n,'ending':ending,'reference_ms':t0,'candidate_ms':t1,'equal':torch.equal(y,ref),'max_abs_delta':(y.float()-ref.float()).abs().max().item()}\n    report['operators'].append(row);print(json.dumps(row),flush=True)\n    del x,mask,ref,y,m\n report['passed']=all(x['mismatches']==0 for x in report['edges']) and all(x['equal'] for x in report['operators'])\nfinally:\n report['isolation']=monitor.stop()\n pathlib.Path('/media/IntelSSD/fireprot/outputs/atlasfold/softmax-compact-probe.json').write_text(json.dumps(report,indent=2))\n print(json.dumps(report),flush=True)\n",
      "sha256": "361b937b886bd1e0696a5f8d246486fc95bac65f02d150523d3007b076a1e942"
    },
    "fireprot_atlas_norm_layout_probe.cu": {
      "source": "#include <torch/extension.h>\n#include <c10/core/DeviceGuard.h>\n#include <c10/hip/HIPStream.h>\n#include <c10/hip/HIPException.h>\n#include <hip/hip_runtime.h>\n__global__ void cast_transposed(const c10::BFloat16* x,float* y,int n,int64_t count){\n int64_t pos=(int64_t(blockIdx.x)*blockDim.x+threadIdx.x)*8;\n if(pos>=count)return;\n int c=pos%128;int64_t pair=pos/128;\n int i=pair/n,j=pair%n;\n int64_t src=(int64_t(j)*n+i)*128+c;\n #pragma unroll\n for(int k=0;k<8;k++)y[pos+k]=float(x[src+k]);\n}\ntorch::Tensor transpose_cast(torch::Tensor x){\n TORCH_CHECK(x.is_cuda()&&x.scalar_type()==at::kBFloat16&&x.dim()==4&&x.size(0)==1&&x.size(3)==128);\n int n=x.size(1);TORCH_CHECK((n==1024||n==1536)&&x.size(2)==n&&x.stride(1)==128&&x.stride(2)==n*128&&x.stride(3)==1);\n c10::DeviceGuard guard(x.device());auto y=torch::empty(x.sizes(),x.options().dtype(at::kFloat));\n hipLaunchKernelGGL(cast_transposed,dim3((x.numel()/8+255)/256),dim3(256),0,c10::hip::getCurrentHIPStream(),x.data_ptr<c10::BFloat16>(),y.data_ptr<float>(),n,x.numel());\n C10_HIP_CHECK(hipGetLastError());return y;\n}\nPYBIND11_MODULE(TORCH_EXTENSION_NAME,m){m.def(\"transpose_cast\",&transpose_cast);}\n",
      "sha256": "31797e35d700cc6f8d567dc4d98b2e830954e9c8673c16054666eadaeeb7bba9"
