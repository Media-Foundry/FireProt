  "reference_script": "\"\"\"One-off upstream API parity reference, no FireProt model worker or acceleration.\"\"\"\nimport json, os, time\nfrom pathlib import Path\nimport torch\nfrom benchmarks.atlasfold.profile_inference import resolve_physical_device\nfrom benchmarks.protenix.profile_inference import _GpuProcessMonitor\nroot=Path('/media/IntelSSD/fireprot')\nout=root/'outputs/protenix-tiny-l124-upstream-v1'\nout.mkdir()\nos.chdir(out)\ntorch.cuda.init()\ndevice=resolve_physical_device()\nmonitor=_GpuProcessMonitor(device['gpu'],os.getpid(),1.0)\nmonitor.start()\ntry:\n    request=json.loads((root/'configs/requests/protenix-tiny-default-l124-smoke-v1.json').read_text())\n    from configs.configs_data import data_configs\n    from configs.configs_inference import inference_configs\n    for key,value in request['resources'].items():data_configs[key]=value['path']\n    inference_configs['load_checkpoint_dir']=str(root/'runtime/checkpoint')\n    from runner import batch_inference, inference\n    torch.set_num_threads(1)\n    torch.backends.cuda.preferred_blas_library('hipblas')\n    torch.backends.cuda.matmul.allow_tf32=False\n    torch.backends.cudnn.allow_tf32=False\n    start=time.perf_counter()\n    batch_inference.inference_jsons(json_file=request['input']['path'],out_dir=str(out/'native'),\n        seeds=[101],n_cycle=4,n_step=1,n_sample=1,dtype='fp32',model_name='protenix_tiny_default_v0.5.0',\n        trimul_kernel='torch',triatt_kernel='torch',enable_cache=True,enable_fusion=True,\n        enable_tf32=False,use_msa=False,use_template=False,use_rna_msa=False,\n        use_seeds_in_json=False,need_atom_confidence=False)\n    assert len(list((out/'native').rglob('*.cif')))==1\n    assert not list((out/'native/ERR').glob('*'))\n    report=dict(request=request,device=device,request_seconds=time.perf_counter()-start)\nfinally:\n    isolation=monitor.stop()\n(out/'reference.json').write_text(json.dumps(dict(**report,isolation=isolation),indent=2)+'\\n')\nassert isolation['passed'],isolation\n",
