  "controller": {
    "source": "\"\"\"Two additional fresh processes on the same GCD for final packaged medians.\"\"\"\nimport hashlib,json,os,pathlib,subprocess,statistics\nroot=pathlib.Path('/media/IntelSSD/fireprot')\nscript=pathlib.Path('/tmp/fireprot_atlas_qkv_packaged_model.py')\noriginal=script.read_text()\nout=root/'outputs/atlasfold/final-qkv-repeats';assert not out.exists();out.mkdir()\npython='/media/PM982/engramfold/folding_e2e_20260921/venvs/atlasfold-rocm/bin/python'\nreport={'status':'running','controller_pid':os.getpid(),'records':[],'base_controller_sha256':hashlib.sha256(script.read_bytes()).hexdigest(),'protocol':'Three fresh packaged requests on HIP7 / SMI5: the preceding r1 plus r2/r3 here. Compare medians with the previously completed three chunked-native requests on the same physical GCD. This is sequential measurement, not three new interleaved pairs.'}\ndef save(): (out/'summary.json').write_text(json.dumps(report,indent=2)+'\\n')\ntry:\n for run in (1,2,3):\n  if run>1:\n   source=original.replace('seed102-r1','seed102-r'+str(run));worker=out/f'controller-r{run}.py';worker.write_text(source)\n   with (out/f'controller-r{run}.log').open('w') as log:subprocess.run([python,str(worker),'1536'],cwd=root,stdout=log,stderr=subprocess.STDOUT,check=True)\n  path=root/f'outputs/atlasfold/packaged-qkv-n1536-seed102-r{run}/validation.json'\n  r=json.loads(path.read_text());assert r['status']=='complete' and all(r['raw_bytes_equal'].values())\n  m=r['manifest'];assert m['device']['gpu']==5 and m['isolation']['passed']\n  report['records'].append({'validation':str(path),'request_seconds':m['first_request_seconds'],'source_sha256':r['source_sha256']});save();print(json.dumps(report['records'][-1]),flush=True)\n assert all(x['source_sha256']==report['records'][0]['source_sha256'] for x in report['records'])\n ref=json.loads((root/'outputs/atlasfold/repeated-pairs-0f15349/summary.json').read_text())\n report['reference_summary']=ref\n report['candidate_median_seconds']=statistics.median(x['request_seconds'] for x in report['records'])\n report['native_median_seconds']=statistics.median(x['records']['chunked']['request_seconds'] for x in ref['pairs'])\n report['speedup']=report['native_median_seconds']/report['candidate_median_seconds'];report['status']='complete';save()\nexcept BaseException as e:\n report['status']='failed';report['error']=repr(e);save();raise\n",
