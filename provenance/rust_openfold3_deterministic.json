  "scatter_probe_source": "import json,hashlib,torch\nfrom openfold3.core.utils.atomize_utils import aggregate_atom_feat_to_tokens\nfrom benchmarks.atlasfold.profile_inference import resolve_physical_device,_GpuProcessMonitor\nimport os\nphysical=resolve_physical_device();monitor=_GpuProcessMonitor(physical['gpu'],os.getpid(),0.1);monitor.start()\ntry:\n torch.manual_seed(101)\n x=torch.randn(1,10000,128,device='cuda',dtype=torch.float32)\n idx=(torch.arange(10000,device='cuda')//10).reshape(1,-1)\n tm=torch.ones(1,1000,device='cuda');am=torch.ones(1,10000,device='cuda')\n out=dict(device=physical,torch=str(torch.__version__),hip=torch.version.hip,shape=list(x.shape),seed=101,synthetic=True,modes={})\n for deterministic in [False,True]:\n  torch.use_deterministic_algorithms(deterministic)\n  values=[]\n  for _ in range(20):\n   v=aggregate_atom_feat_to_tokens(tm,idx,am,x,atom_dim=1,aggregate_fn='mean')\n   torch.cuda.synchronize();values.append(v.cpu())\n  hashes=[hashlib.sha256(v.numpy().tobytes()).hexdigest() for v in values]\n  out['modes'][str(deterministic)]=dict(unique_hashes=len(set(hashes)),hashes=hashes,max_delta_to_first=max((v-values[0]).abs().max().item() for v in values),deterministic_enabled=torch.are_deterministic_algorithms_enabled())\nfinally:\n out['isolation']=monitor.stop()\nprint(json.dumps(out,indent=2))\n",
